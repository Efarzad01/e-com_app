# Mobile App Development Environment

# API Configuration (use your local IP for physical devices)
# For iOS Simulator: localhost or 127.0.0.1
# For Android Emulator: 10.0.2.2
# For Physical Devices: Your computer's local IP (e.g., 192.168.1.100)
API_URL=http://localhost:5000/api/v1

# Stripe (Test Mode)
STRIPE_PUBLISHABLE_KEY=pk_test_51234567890abcdef

# App Configuration
APP_NAME=E-Commerce
APP_VERSION=1.0.0
APP_BUNDLE_ID=com.ecommerce.app

# Feature Flags
ENABLE_BIOMETRICS=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_ANALYTICS=false

# Development
DEBUG_MODE=true
