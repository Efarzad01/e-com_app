# Development Environment
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database (using Docker Compose values)
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/ecommerce?schema=public"

# JWT Configuration - DEVELOPMENT KEYS ONLY!
JWT_ACCESS_SECRET=dev-super-secret-jwt-access-key-for-development-only-change-in-production
JWT_REFRESH_SECRET=dev-super-secret-jwt-refresh-key-for-development-only-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Encryption - DEVELOPMENT KEY ONLY!
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Email Configuration (Use Mailtrap for development)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your-mailtrap-user
SMTP_PASSWORD=your-mailtrap-password
EMAIL_FROM=noreply@ecommerce-dev.local

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Stripe (Test Mode)
STRIPE_SECRET_KEY=sk_test_51234567890abcdef
STRIPE_PUBLISHABLE_KEY=pk_test_51234567890abcdef
STRIPE_WEBHOOK_SECRET=whsec_test1234567890

# OAuth2 (Google) - Use your test credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# OAuth2 (Facebook) - Use your test credentials
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/v1/auth/facebook/callback

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# CDN (Optional - leave empty for development)
CDN_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# Rate Limiting (Relaxed for development)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Security
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=10
ACCOUNT_LOCKOUT_DURATION=300000

# Logging
LOG_LEVEL=debug
